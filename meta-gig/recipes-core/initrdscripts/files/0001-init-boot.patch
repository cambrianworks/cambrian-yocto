 fi
 
-echo "Mounting ${rootdev}..."
+echo "Mounting ${rootdev}..." > /dev/ttyTCU0
 [ -d /mnt ] || mkdir -p /mnt
 count=0
 while [ $count -lt 5 ]; do
@@ -52,7 +80,7 @@
 
 [ ! -f /etc/platform-pre-switchroot ] || . /etc/platform-pre-switchroot
 
-echo "Switching to rootfs on ${rootdev}..."
