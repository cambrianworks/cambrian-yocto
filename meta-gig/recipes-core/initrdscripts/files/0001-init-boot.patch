Upstream-Status: Inappropriate [Cambrian-specific: honour root= from extlinux.conf
ahead of the build-time boot drive, falls back to platform-preboot if
the requested root never appears instead of waiting forever.]

--- a/init-boot.sh
+++ b/init-boot.sh
@@ -17,28 +17,56 @@
 wait=""
 fstype="auto"
 
-[ ! -f /etc/platform-preboot ] || . /etc/platform-preboot
+rootspec=""
+for bootarg in `cat /proc/cmdline`; do
+    case "$bootarg" in
+        root=*) rootspec="${bootarg##root=}" ;;
+        ro) opt="ro" ;;
+        rootwait) wait="yes" ;;
+        rootfstype=*) fstype="${bootarg##rootfstype=}" ;;
+    esac
+done
 
-if [ -z "$rootdev" ]; then
-    for bootarg in `cat /proc/cmdline`; do
-        case "$bootarg" in
-            root=*) rootdev="${bootarg##root=}" ;;
-            ro) opt="ro" ;;
-            rootwait) wait="yes" ;;
-            rootfstype=*) fstype="${bootarg##rootfstype=}" ;;
-        esac
-    done
+# Turn a root= value into a block device node. Kernel names such as
+# /dev/nvme1n1p1 are not stable when there is more than one NVMe drive:
+# the nvme driver probes controllers in parallel, so nvme0/nvme1 can swap
+# between boots. Tag forms (PARTUUID= etc.) are resolved with blkid, which
+# tegra-minimal-init already pulls into this initramfs.
+resolve_root() {
+    case "$1" in
+        PARTUUID=*|PARTLABEL=*|UUID=*|LABEL=*)
+            blkid -c /dev/null -l -o device -t "$1" 2>/dev/null ;;
+        *)
+            echo "$1" ;;
+    esac
+}
+
+if [ -n "$rootspec" ]; then
+    echo "rootfs from cmd args: ${rootspec}" > /dev/ttyTCU0
+    rootdev=$(resolve_root "$rootspec")
+    if [ -n "$wait" ] && [ ! -b "${rootdev}" ]; then
+        echo "Waiting for ${rootspec}..." > /dev/ttyTCU0
+        for count in $(seq 1 60); do
+            rootdev=$(resolve_root "$rootspec")
+            [ -b "${rootdev}" ] && break
+            sleep 0.5
+        done
+    fi
+    if [ ! -b "${rootdev}" ]; then
+        # Don't hang forever on a missing drive: fall back to the
+        # platform default (APP/APP_b on the build-time boot drive).
+        echo "${rootspec} not found, falling back to platform default" > /dev/ttyTCU0
+        rootdev=""
+    fi
+else
+    echo "rootfs not specified in cmd args" > /dev/ttyTCU0
 fi
 
